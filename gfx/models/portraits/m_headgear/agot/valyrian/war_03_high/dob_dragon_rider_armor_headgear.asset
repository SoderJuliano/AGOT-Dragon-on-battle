# Dragon on Battle — Dragon Rider's Plate: Headgear Asset
# Uses the AGOT Blackfyre war_03_high helm mesh with our recolored steel+gold diffuse.

pdxmesh = {
        name = "dob_dragon_rider_armor_headgear_mesh"
        file = "male_headgear_secular_valyrian_war_03_high.mesh"

        blend_shape = { id = "male_headgear_secular_valyrian_war_03_high_bs_fat" type = "male_headgear_secular_valyrian_war_03_high_bs_fat.mesh" }

        meshsettings = {
                name = "male_headgear_secular_valyrian_war_03_highShape"
                index = 0
                texture_diffuse  = "dob_dragon_rider_headgear_diffuse.dds"
                texture_normal   = "male_headgear_secular_valyrian_war_03_high_normal.dds"
                texture_specular = "male_headgear_secular_valyrian_war_03_high_properties.dds"
                shader      = "portrait_attachment_alpha_to_coverage"
                shader_file = "gfx/FX/jomini/portrait.shader"
        }
}

entity = {
        name = "dob_dragon_rider_armor_headgear_entity"
        pdxmesh = "dob_dragon_rider_armor_headgear_mesh"

        attribute = { name = "bs_fat_1" blend_shape = "male_headgear_secular_valyrian_war_03_high_bs_fat" }

        game_data = {
                portrait_entity_user_data = {
                        portrait_accessory = {
                                # Reuses the same CoA masking pattern as the original AGOT headgear
                                pattern_mask = "gfx/models/portraits/m_clothes/agot/blankmask/agot_blank_clothes_mask.dds"
                                variation = "AGOT_coa_valyrian_armor"
                        }
                }
        }
}
